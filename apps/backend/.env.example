APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://dev:devpass@postgres:5432/strongpm

ALLOWED_ORIGINS=http://localhost:3000

# Jira (Atlassian Cloud)
JIRA_BASE_URL=https://lunit.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=RAD,ODM

# Confluence (Atlassian Cloud) — reuses JIRA_BASE_URL/EMAIL/API_TOKEN for auth.
# Release notes are published as child pages under these parent page ids.
CONFLUENCE_SPACE_KEY=
CONFLUENCE_ODM_PARENT_ID=
CONFLUENCE_ANNOTATION_PARENT_ID=

# AI (Anthropic Claude) — release-note generation + jira ticket generation
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Optional: Anthropic-compatible gateway. Leave empty for the public Anthropic API.
ANTHROPIC_BASE_URL=

# GitHub — Deployment Tracker (personal access token with repo read scope)
GITHUB_TOKEN=
# Override default repo list if needed (comma-separated owner/repo)
# GITHUB_REPOS=lunit-io/aip-oncology,...

# Jira Ticket Writer — project key and board IDs for sprint lookup (Agile API)
JIRA_TICKET_PROJECT_KEY=RAD
# Version Assignment — JQL project identifier (key or name) for unversioned ticket search
# e.g. "RAD" or "[AIP] Onco Space"
JIRA_VERSION_ASSIGN_PROJECT=RAD
# Format: "Product=boardId,Product=boardId"  e.g. "ODM=123,Annotation Admin=456,Annotation Tool=789"
JIRA_BOARD_IDS=

# Sprint Report Creator — board ID for sprint list. Example page used as few-shot reference.
JIRA_SPRINT_BOARD_ID=324
CONFLUENCE_SPRINT_EXAMPLE_PAGE_ID=5400365750
